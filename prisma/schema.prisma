generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Status {
  todo
  in_progress
  done
}

enum Priority {
  low
  medium
  high
}

enum MemberRole {
  owner
  member
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  // optional for now; Week 4 (auth) makes it required
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships   ProjectMember[]
  assignedTasks Task[]

  @@map("users")
}

model Project {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String          @unique @default(cuid())
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  members ProjectMember[]
  tasks   Task[]

  @@map("projects")
}

// Explicit join table for the many-to-many between users and projects
model ProjectMember {
  projectId Int        @map("project_id")
  userId    Int        @map("user_id")
  role      MemberRole @default(member)
  joinedAt  DateTime   @default(now()) @map("joined_at") @db.Timestamptz(3)

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id        Int       @id @default(autoincrement())
  title     String
  status    Status    @default(todo)
  priority  Priority  @default(medium)
  dueDate   DateTime? @map("due_date") @db.Date
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  projectId  Int? @map("project_id")
  assigneeId Int? @map("assignee_id")

  // Restrict = refuse to delete a project that still has tasks (the old 409)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  // SetNull = deleting a user just unassigns their tasks
  assignee User?     @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  comments Comment[]

  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
  @@index([createdAt, id])
  @@index([status, dueDate, id])
  @@map("tasks")
}

model Comment {
  id        Int       @id @default(autoincrement())
  taskId    Int       @map("task_id")
  // a plain string for now; Week 4 replaces it with the logged-in user
  author    String
  body      String    @map("content")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime? @map("updated_at") @db.Timestamptz(3)

  // Cascade = a comment cannot outlive its task
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("comments")
}
