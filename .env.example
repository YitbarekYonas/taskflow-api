NODE_ENV=development
LOG_LEVEL=info
PORT=3000
CORS_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Limits are OFF in development so the test scripts can run freely. Must be true in production.
RATE_LIMIT_ENABLED=false
# Number of reverse proxies in front of the app. 0 when clients connect directly.
TRUST_PROXY_HOPS=0
# Set to false to hide /docs and /openapi.json on a private API
DOCS_ENABLED=true
# Leave empty to keep rate limits in each process's memory. Required in production.
REDIS_URL=redis://localhost:6379
# queue needs REDIS_URL and a worker (npm run worker). inline runs jobs inside the API process.
JOBS_MODE=queue
# smtp sends through SMTP_URL (Mailpit in development). log only writes a log line.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="TaskFlow <noreply@taskflow.local>"
