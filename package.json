{
  "name": "taskflow",
  "version": "1.0.0",
  "description": "Task manager CLI built with Node.js and TypeScript",
  "main": "index.js",
"scripts": {
  "dev": "tsx watch src/server.ts",
  "start": "node dist/server.js",
  "cli": "tsx src/cli.ts",
  "build": "tsc",
  "typecheck": "tsc --noEmit",
  "clean": "rm -rf dist"
},
  "keywords": [
    "taskflow",
    "task-manager",
    "cli",
    "typescript",
    "nodejs"
  ],
  "author": "Yitbarek Yonas",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "zod": "^4.6.5"
  }
}
