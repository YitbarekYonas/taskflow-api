{
  "name": "taskflow",
  "version": "0.5.0",
  "description": "Task manager API built with Node.js, Express, and TypeScript",
  "main": "index.js",
  "scripts": {
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/db-check.ts",
    "db:n1": "tsx scripts/n-plus-one.ts",
    "db:bench-seed": "tsx scripts/seed-bench.ts",
    "db:bench-clean": "tsx scripts/seed-bench.ts --clean",
    "bench": "tsx scripts/bench.ts",
    "db:tx-demo": "tsx scripts/tx-demo.ts",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "db:deploy": "prisma migrate deploy",
    "db:fresh": "prisma migrate reset --force && prisma db seed",
    "db:check-migrations": "bash scripts/check-migrations.sh",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "setup": "npm run db:up && npm run db:deploy && npm run db:generate && npm run db:seed",
    "bench:login": "tsx scripts/login-timing.ts",
    "auth:purge": "tsx scripts/purge-tokens.ts",
    "typecheck:all": "tsc -p tsconfig.scripts.json",
    "verify": "bash scripts/verify.sh",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "precheck": "npm run typecheck:all && npm run lint && npm run format:check && npm run lint:openapi && npm run test:unit && npm run build",
    "ci": "npm run precheck && npm run test:coverage",
    "dev": "tsx watch src/server.ts | pino-pretty",
    "dev:json": "tsx watch src/server.ts",
    "lint:openapi": "tsx scripts/export-openapi.ts && redocly lint .tmp/openapi.json"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,yml,yaml,mjs}": "prettier --write"
  },
  "keywords": [
    "taskflow",
    "task-manager",
    "api",
    "typescript",
    "nodejs",
    "express",
    "prisma"
  ],
  "author": "Yitbarek Yonas",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@redocly/cli": "^2.77.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  }
}
