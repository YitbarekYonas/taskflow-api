{
  "name": "taskflow",
  "version": "0.2.0",
  "description": "Task manager API built with Node.js, Express, and TypeScript",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "cli": "tsx src/cli.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:check": "tsx scripts/db-check.ts",
    "db:n1": "tsx scripts/n-plus-one.ts",
    "db:bench-seed": "tsx scripts/seed-bench.ts",
    "db:bench-clean": "tsx scripts/seed-bench.ts --clean",
    "bench": "tsx scripts/bench.ts",
    "db:tx-demo": "tsx scripts/tx-demo.ts"
  },
  "keywords": [
    "taskflow",
    "task-manager",
    "api",
    "typescript",
    "nodejs",
    "express",
    "prisma"
  ],
  "author": "Yitbarek Yonas",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.5"
  }
}